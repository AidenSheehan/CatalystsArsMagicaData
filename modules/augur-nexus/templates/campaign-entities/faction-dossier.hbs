<section class="site-preview-shell place-preview-shell npc-dossier-shell faction-dossier-shell" style="{{backgroundStyle}}">
    <div class="site-preview-shade"></div>

    {{#if missing}}
    <div class="npc-dossier-missing">This organization could not be found.</div>
    {{else}}
    <div class="site-preview-stage npc-dossier-stage">
        <aside class="site-preview-dossier place-preview-dossier npc-dossier-profile" data-connections-drop-surface>
            {{> "modules/augur-nexus/templates/campaign-entities/faction-profile-panel.hbs" profile=faction.profile}}

            {{#if dossier.isJournalTab}}
            <section class="npc-dossier-section npc-dossier-journal">
                <div class="npc-dossier-journal-body">
                {{#if journal.hasPage}}
                {{#if journal.hasContent}}
                <div class="npc-dossier-journal-content">
                    {{{journal.content}}}
                </div>
                {{else}}
                <div class="npc-dossier-empty">This journal is blank.</div>
                {{/if}}
                {{else}}
                <div class="npc-dossier-empty">No journal has been created for this organization.</div>
                {{/if}}
                </div>
                {{#if isGM}}
                <footer class="npc-dossier-journal-footer">
                    <button type="button" class="npc-dossier-secondary" data-action="{{#if journal.hasPage}}openFactionJournal{{else}}createFactionJournal{{/if}}">
                        <i class="fas {{#if journal.hasPage}}fa-book-open{{else}}fa-book-medical{{/if}}"></i>
                        <span>{{#if journal.hasPage}}Edit Journal{{else}}Create Journal{{/if}}</span>
                    </button>
                </footer>
                {{/if}}
            </section>
            {{/if}}
        </aside>

        <section class="site-preview-cover npc-dossier-connections" aria-label="Organization connections">
            {{> "modules/augur-nexus/templates/connections/connections-board.hbs" connections.board}}
            {{#if isGM}}
            <button type="button" class="faction-new-member-button" data-action="createFactionMember">
                <i class="fas fa-user-plus"></i>
                <span>New Member</span>
            </button>
            {{/if}}
        </section>
    </div>
    {{/if}}
</section>
